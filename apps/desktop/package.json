{
  "name": "@solline/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Cliente de desktop para o Claude Code.",
  "author": "Duarte Cunha",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --config electron-builder.config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@solline/engine": "workspace:*",
    "@solline/protocol": "workspace:*",
    "@solline/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7"
  }
}
