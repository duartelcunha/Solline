{
  "name": "solline",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @solline/desktop dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "dist": "corepack pnpm --filter @solline/desktop dist",
    "qa:renderer": "corepack pnpm --filter @solline/desktop qa:renderer",
    "qa:electron": "corepack pnpm --filter @solline/desktop qa:electron",
    "qa:canary": "corepack pnpm --filter @solline/desktop qa:canary",
    "qa:recovery-canary": "corepack pnpm --filter @solline/desktop qa:recovery-canary",
    "qa:distribution": "corepack pnpm --filter @solline/desktop qa:distribution",
    "qa:verify": "corepack pnpm --filter @solline/desktop qa:verify",
    "updates:check": "node scripts/check-updates.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
